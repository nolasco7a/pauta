# El SDK de Expo instala expo-router como dependencia opcional interna de otros paquetes
# aunque esta app no lo usa (usa @react-navigation/native directamente). Sin esto, el bundler
# falla con "expo-router is no longer compatible with react-navigation".
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
DEEPL_API_KEY="20ef7825-c261-4569-9d67-91054f56a5d7:fx"
